# Agent Bridge technical runtime configuration.
# Copy to /etc/agent-bridge/agent-bridge.env and protect it with mode 0600.
# Do not persist one-time enrollment tokens in this file.

KAB_PLATFORM_BASE_URL=https://kairoseth.com
KAB_STATE_DIR=/var/lib/agent-bridge
KAB_DEPLOYMENT_MODE=local
KAB_ALLOW_INSECURE_HTTP=false
