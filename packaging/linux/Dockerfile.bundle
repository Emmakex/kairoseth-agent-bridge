# syntax=docker/dockerfile:1.7
FROM node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

ARG KAB_VERSION
ARG KAB_REVISION
ARG KAB_RUNTIME_ARTIFACT_SHA256

ENV NODE_ENV=production
WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force

COPY README.md ./
COPY dist/src ./dist/src
COPY packaging/linux ./packaging/linux
COPY docs/LINUX_SERVICE_DEPLOYMENT.md ./docs/LINUX_SERVICE_DEPLOYMENT.md
COPY scripts/build-linux-service-bundle.sh ./scripts/build-linux-service-bundle.sh

RUN mkdir -p /out \
  && bash scripts/build-linux-service-bundle.sh \
    "$KAB_VERSION" \
    "$KAB_REVISION" \
    "$KAB_RUNTIME_ARTIFACT_SHA256" \
    /out/agent-bridge-linux-x64.tar.gz \
    /workspace/node_modules

# This image is a packaging vehicle only. Workflows extract only the final
# deterministic archive from /out; no image layer is shipped to customers.
CMD ["/bin/true"]
