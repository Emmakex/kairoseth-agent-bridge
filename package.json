{
  "name": "kairoseth-agent-bridge",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Technical Agent Bridge runtime powering Integración de agentes de IA / AI Integration in Kairoseth Platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assert-release-runtime-surface.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start:runtime": "node dist/src/cli/agent-bridge-runtime.js run",
    "runtime:healthcheck": "node dist/src/cli/agent-bridge-runtime.js healthcheck",
    "acceptance:phase7-platform": "node dist/src/cli/phase7-real-platform-acceptance.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
